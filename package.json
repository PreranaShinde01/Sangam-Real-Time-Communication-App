{
  "name": "sangam-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sangam - Real-time video conferencing and collaboration platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace=@sangam/server",
    "dev:web": "npm run dev --workspace=@sangam/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace=@sangam/server",
    "test": "npm run test --workspaces --if-present",
    "seed": "npm run seed --workspace=@sangam/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
