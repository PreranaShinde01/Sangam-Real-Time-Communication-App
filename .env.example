# ==============================================================================
# Sangam Environment Configuration
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173

# Database configuration (Defaults to local SQLite if DATABASE_URL is not set)
DATABASE_URL=file:./dev.db
# For PostgreSQL: postgresql://sangam:sangam_secret_password@localhost:5432/sangam_db?schema=public

# Redis configuration (Optional: fallback to in-memory store if Redis is absent)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=sangam_dev_jwt_access_secret_key_32_bytes_min_at_least
JWT_REFRESH_SECRET=sangam_dev_jwt_refresh_secret_key_32_bytes_min_at_least
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Credentials (Optional in local development)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# STUN / TURN Configuration
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
FILE_TTL_HOURS=24
